# Core
SECRET_KEY=change-me
DEBUG=False
# Set True only for a cloud production deployment. Production requires MySQL,
# a unique SECRET_KEY, and DEBUG=False; desktop installs keep their local SQLite DB.
DURIELBIZ_PRODUCTION=False
# Relative paths resolve from the project root; Docker mounts ./data at /app/data.
DURIELBIZ_DATA_DIR=data
# Required when DURIELBIZ_PRODUCTION=True, for example mysql://user:password@host:3306/database
DATABASE_URL=
DURIELBIZ_ALLOWED_HOSTS=127.0.0.1,localhost,durieltech.pythonanywhere.com
DURIELBIZ_CSRF_TRUSTED_ORIGINS=https://durieltech.pythonanywhere.com

# Cloud sync endpoint included in the Windows desktop build. Set this before packaging;
# the installer collects a business referral key and redeems it at this endpoint.
DURIELBIZ_SYNC_URL=https://your-cloud-host.example.com/api/sync/
# These are populated automatically after referral-key pairing on the desktop.
DURIELBIZ_SYNC_TOKEN=
DURIELBIZ_SYNC_DEVICE_ID=
DURIELBIZ_SYNC_BUSINESS_SLUG=

# Email / admin alerts
ADMIN_NAME=DurielTech Admin
ADMIN_EMAIL=info@durieltech.com.ng
DEFAULT_FROM_EMAIL=info@durieltech.com.ng
SERVER_EMAIL=info@durieltech.com.ng
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=info@durieltech.com.ng
EMAIL_HOST_PASSWORD=ENC(paste-encrypted-value-here)
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20

# Optional encrypted env support
# Generate a key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DURIELBIZ_ENV_KEY=

# Desktop trial/licensing (leave LICENSE_MASTER_KEY_HASH blank to disable enforcement).
# Generate a key once with `python manage.py generate_master_key`, keep the plaintext
# key offline and secret, and paste only the hash here before building the installer.
LICENSE_MASTER_KEY_HASH=
LICENSE_TRIAL_DAYS=14
